{
  "name": "agent-work-contract",
  "version": "1.6.0",
  "description": "Portable AI working contract: rules, skills, subagents, commands and runtime hooks for any coding agent (ZCode / Claude Code / opencode / Codex / generic).",
  "license": "MIT",
  "private": false,
  "bin": {
    "agent-work-contract": "install.js"
  },
  "scripts": {
